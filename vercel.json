{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["gru1"],
  "git": {
    "deploymentEnabled": {
      "integration/cost-intelligence-industrial-v2": false,
      "feature/licitaciones-rfq-intelligence": false,
      "feature/licitaciones-radar": false,
      "feature/licitaciones-escaner-diario": false
    }
  },
  "crons": [
    { "path": "/api/licitaciones/cron", "schedule": "0 9 * * *" }
  ],
  "ignoreCommand": "case \"$VERCEL_GIT_COMMIT_REF\" in feature/*|integration/*) exit 0;; *) exit 1;; esac"
}

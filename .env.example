# ================================================================
# NIU INTELLIGENCE OS - ENVIRONMENT CONFIGURATION
# ================================================================

# --- SUPABASE POSTGRESQL & AUTH ---
# CLIENT-SAFE: URL and publishable/anon keys may be exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER-ONLY SECRET: never use NEXT_PUBLIC_ for this key.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# SERVER-ONLY SECRET: use only for trusted migrations/administration.
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- OPENAI RESPONSES API & WEB SEARCH ---
# SERVER-ONLY SECRET.
OPENAI_API_KEY=sk-proj-your-openai-api-key
OPENAI_MODEL_VISIBILITY=gpt-4o
OPENAI_MODEL_ANALYSIS=gpt-4o-mini
OPENAI_MODEL_STRATEGY=gpt-4o

# --- CORREO CORPORATIVO SMTP (MAIL DE LA PAGINA DE FLEXIBLES) ---
# SERVER-ONLY SECRET: SMTP_PASS must never be prefixed with NEXT_PUBLIC_.
# Usá estos datos para que el bot mande las cotizaciones (RFQs) desde tu correo de la empresa:
SMTP_HOST=mail.tudominio.com
SMTP_PORT=465
SMTP_USER=compras@tudominio.com
SMTP_PASS=tu-contraseña-de-correo
SMTP_SECURE=true
MAIL_FROM=compras@tudominio.com
MAIL_FROM_NAME="NIUPACK Abastecimiento Industrial"

# --- GMAIL CORPORATE EMAIL AGENT (OAUTH2 OPCIONAL) ---
# SERVER-ONLY SECRETS: client secret and refresh token never reach the browser.
GMAIL_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-your-google-oauth-client-secret
GMAIL_REDIRECT_URI=http://localhost:3000/api/auth/callback/gmail
GMAIL_REFRESH_TOKEN=1//04your-gmail-oauth-refresh-token
GMAIL_USER_EMAIL=inteligencia@niupack.com.py

# --- OPERATIONAL & COST CONTROLS ---
MAX_QUERIES_PER_RUN=2000
MAX_CONCURRENCY=5
MAX_SPEND_PER_RUN_USD=25.00
MAX_MONTHLY_SPEND_USD=250.00

# --- NIUPACK OFFICIAL PUBLIC IDENTITY ---
PUBLIC_SITE_URL=https://bjjrage.github.io/niupack/
FUTURE_CANONICAL_DOMAIN=https://niupack.com.py/
NIUPACK_PUBLIC_URL=https://niupack.com.py
NIUPACK_BRAND_NAME="NIU PACK"
NIUPACK_COMPANY_NAME="GARDINER S.A."
NIUPACK_ORIGIN_COUNTRY="Paraguay"


# --- NIUPACKBOT / WHATSAPP (TWILIO) — SERVER ONLY ---
# Producción exige TODAS. Sin ellas el webhook NO procesa inbound (fail-closed, TwiML vacío).
# NUNCA usar prefijo NEXT_PUBLIC_ para estos secretos.
# NIUPACKBOT_ORGANIZATION_ID debe ser el UUID de la organización NIUPACK existente (se verifica en DB).
NIUPACKBOT_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+595900000000
TWILIO_WEBHOOK_URL=https://tu-deploy/api/niupackbot/whatsapp
# Campañas (outbound): Twilio avisa sent/delivered/read/failed a esta URL. Si se omite, se usa
# TWILIO_WEBHOOK_URL + "/status". Debe ser EXACTAMENTE la URL pública (la firma se valida contra ella).
TWILIO_STATUS_CALLBACK_URL=https://tu-deploy/api/niupackbot/whatsapp/status
# Secreto del scheduler de campañas (Authorization: Bearer ...). Generar uno largo y aleatorio.
# Sin esto la cola solo avanza mientras alguien tiene abierta una campaña en el CRM.
CRON_SECRET=

# --- LOGISTICS PROVIDERS ---
# Freightos public marketplace estimates require no API key.
# Public absolute origin used to build secure supplier quote links.
# CLIENT-SAFE PUBLIC URL. Use the deployed HTTPS origin in production; localhost is rejected there.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- ICONTAINERS BRUTUS API (FCL MARÍTIMO) — SERVER ONLY ---
ICONTAINERS_API_TOKEN=
ICONTAINERS_API_ENV=development
ICONTAINERS_ENABLED=false
